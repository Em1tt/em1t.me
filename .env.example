# Contact form (src/routes/+page.server.ts). Copy to .env for local development;
# on Cloudflare, set these as variables/secrets on the project instead.
DISCORD_WEBHOOK=
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare's Turnstile test keys always pass, for trying the form locally:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
