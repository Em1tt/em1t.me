# Copy to .env for local development; on Cloudflare, these are Worker secrets
# (npx wrangler secret put <NAME>), and PUBLIC_TURNSTILE_SITE_KEY is a var in wrangler.jsonc.

# Contact form (src/routes/+page.server.ts).
DISCORD_WEBHOOK=
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=

# Blog comments (src/lib/server/comments.ts) and signing in at /admin to reply as Em1t.
# IP_HASH_SECRET is any long random string; it keys the hashed IPs used for rate limits.
COMMENTS_WEBHOOK=
ADMIN_PASSWORD=
IP_HASH_SECRET=

# Cloudflare's Turnstile test keys always pass, for trying the forms locally:
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
